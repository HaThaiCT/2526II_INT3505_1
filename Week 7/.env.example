# MongoDB Configuration
# Copy file này thành .env và điền thông tin của bạn

# MongoDB Local
MONGO_URI=mongodb://localhost:27017/product_management

# MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/product_management?retryWrites=true&w=majority

# MongoDB Docker
# MONGO_URI=mongodb://localhost:27017/product_management

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
