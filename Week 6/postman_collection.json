              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/my-borrows",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "my-borrows"]
            }
          }
        },
        {
          "name": "Get My Active Borrows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/my-active-borrows",
              "host": ["{{baseUrl}}"],
