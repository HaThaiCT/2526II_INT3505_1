	"item": [
		{
			"name": "Setup - Reset Data",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Reset should succeed', function () {",
							"    pm.response.to.have.status(200);",
							"    pm.expect(pm.response.json().success).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{base_url}}/books/reset",
					"host": ["{{base_url}}"],
					"path": ["books", "reset"]
				},
				"description": "Reset data to initial state before running tests"
			},
			"response": []
		},
		{
			"name": "1. Get All Books",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Status code should be 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2: Response should be JSON",
							"pm.test('Response is JSON', function () {",
							"    pm.response.to.be.json;",
							"});",
							"",
							"// Test 3: Response should have required fields",
							"pm.test('Response has required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success');",
							"    pm.expect(jsonData).to.have.property('count');",
							"    pm.expect(jsonData).to.have.property('books');",
							"});",
							"",
							"// Test 4: Books should be an array",
							"pm.test('Books is an array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.books).to.be.an('array');",
							"});",
							"",
							"// Test 5: Initial data should have 3 books",
							"pm.test('Initial data has 3 books', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.count).to.equal(3);",
							"    pm.expect(jsonData.books).to.have.lengthOf(3);",
							"});",
							"",
							"// Test 6: Each book should have required properties",
							"pm.test('Books have required properties', function () {",
							"    const jsonData = pm.response.json();",
							"    jsonData.books.forEach(book => {",
							"        pm.expect(book).to.have.property('id');",
							"        pm.expect(book).to.have.property('title');",
							"        pm.expect(book).to.have.property('author');",
							"        pm.expect(book).to.have.property('isbn');",
							"        pm.expect(book).to.have.property('year');",
							"        pm.expect(book).to.have.property('available');",
							"    });",
							"});",
							"",
							"// Save first book ID for later tests",
							"const jsonData = pm.response.json();",
							"if (jsonData.books.length > 0) {",
							"    pm.environment.set('existing_book_id', jsonData.books[0].id);",
							"    pm.environment.set('existing_book_isbn', jsonData.books[0].isbn);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/books",
					"host": ["{{base_url}}"],
					"path": ["books"]
				},
				"description": "Get all books from the library"
			},
			"response": []
		},
		{
			"name": "2. Get Book by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Status code should be 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2: Response should have success and book",
							"pm.test('Response has success and book', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData).to.have.property('book');",
							"});",
							"",
							"// Test 3: Book ID should match requested ID",
							"pm.test('Book ID matches requested ID', function () {",
							"    const jsonData = pm.response.json();",
							"    const requestedId = parseInt(pm.environment.get('existing_book_id'));",
							"    pm.expect(jsonData.book.id).to.equal(requestedId);",
							"});",
							"",
							"// Test 4: Book should have all required fields",
							"pm.test('Book has all required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.book).to.have.all.keys('id', 'title', 'author', 'isbn', 'year', 'available', 'created_at');",
							"});",
							"",
							"// Test 5: Response time should be less than 200ms",
							"pm.test('Response time is less than 200ms', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/books/{{existing_book_id}}",
					"host": ["{{base_url}}"],
					"path": ["books", "{{existing_book_id}}"]
				},
				"description": "Get a specific book by ID"
			},
			"response": []
		},
