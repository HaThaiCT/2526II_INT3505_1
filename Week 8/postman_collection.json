		{
			"name": "3c. Create Book - Duplicate ISBN",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Status code should be 409",
							"pm.test('Status code is 409 for duplicate ISBN', function () {",
							"    pm.response.to.have.status(409);",
							"});",
							"",
							"// Test 2: Response should indicate conflict",
							"pm.test('Response indicates conflict', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.false;",
							"    pm.expect(jsonData.error).to.include('ISBN already exists');",
							"});"
						],
						"type": "text/javascript"
					}
				}
