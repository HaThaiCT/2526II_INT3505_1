		{
			"name": "5. Delete Book",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Status code should be 200",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2: Response should indicate success",
							"pm.test('Response indicates success', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"    pm.expect(jsonData.message).to.equal('Book deleted successfully');",
							"});",
							"",
							"// Test 3: Verify book is deleted by trying to get it",
							"setTimeout(function() {",
							"    pm.sendRequest({",
							"        url: pm.environment.get('base_url') + '/books/' + pm.environment.get('new_book_id'),",
							"        method: 'GET'",
							"    }, function (err, response) {",
							"        pm.test('Book no longer exists after deletion', function () {",
							"            pm.expect(response.code).to.equal(404);",
							"        });",
							"    });",
							"}, 100);"
						],
						"type": "text/javascript"
					}
				}
